APP_NAME="SuperÓptica 20 20"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Reemplaza por el dominio real antes de publicar.
APP_URL=https://superoptica.example.cu

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/Havana

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Unica base de datos permitida: espejuelos.
# Produccion (cPanel): MySQL con DB_DATABASE=espejuelos.
# Desarrollo local: cambia a DB_CONNECTION=sqlite y elimina DB_HOST, DB_PORT,
# DB_DATABASE, DB_USERNAME y DB_PASSWORD.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=espejuelos
DB_USERNAME=espejuelos
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hola@superoptica.example.cu"
MAIL_FROM_NAME="${APP_NAME}"

# Disco de las imagenes del catalogo (Spatie Media Library).
MEDIA_DISK=public
IMAGE_DRIVER=gd

# Contrasena del administrador inicial para AdminUserSeeder.
ADMIN_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
